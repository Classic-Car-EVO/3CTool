<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ThreeCTool.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThreeCTool.Core\ThreeCTool.Core.csproj" />
    <ProjectReference Include="..\ThreeCTool.Data\ThreeCTool.Data.csproj" />
    <ProjectReference Include="..\ThreeCTool.Geometry\ThreeCTool.Geometry.csproj" />
    <ProjectReference Include="..\ThreeCTool.Compute\ThreeCTool.Compute.csproj" />
    <ProjectReference Include="..\ThreeCTool.Toolpaths\ThreeCTool.Toolpaths.csproj" />
    <ProjectReference Include="..\ThreeCTool.Feeds\ThreeCTool.Feeds.csproj" />
    <ProjectReference Include="..\ThreeCTool.Additive\ThreeCTool.Additive.csproj" />
    <ProjectReference Include="..\ThreeCTool.Cutting\ThreeCTool.Cutting.csproj" />
    <ProjectReference Include="..\ThreeCTool.Thermal\ThreeCTool.Thermal.csproj" />
    <ProjectReference Include="..\ThreeCTool.Simulation\ThreeCTool.Simulation.csproj" />
    <ProjectReference Include="..\ThreeCTool.Post\ThreeCTool.Post.csproj" />
    <ProjectReference Include="..\ThreeCTool.Rendering\ThreeCTool.Rendering.csproj" />
    <ProjectReference Include="..\ThreeCTool.Streaming\ThreeCTool.Streaming.csproj" />
    <ProjectReference Include="..\ThreeCTool.Feeder.Contracts\ThreeCTool.Feeder.Contracts.csproj" />
    <ProjectReference Include="..\ThreeCTool.Feeder.Service\ThreeCTool.Feeder.Service.csproj" />
  </ItemGroup>
</Project>
