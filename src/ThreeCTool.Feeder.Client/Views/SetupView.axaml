<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThreeCTool.Feeder.ViewModels"
             x:Class="ThreeCTool.Feeder.Views.SetupView"
             x:DataType="vm:SetupViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="SettingRow" x:DataType="vm:SettingViewModel">
      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="16" />
        <Button Grid.Column="1" MinWidth="200" HorizontalContentAlignment="Right"
                Command="{Binding $parent[UserControl].((vm:SetupViewModel)DataContext).EditCommand}" CommandParameter="{Binding}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding Value}" />
            <TextBlock Text="{Binding Unit}" Classes="label" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer>
      <StackPanel Spacing="2" Margin="4,0,12,0">
        <TextBlock Text="Settings and desktop pairing are managed on the feeder's own screen." Classes="label" TextWrapping="Wrap"
                   IsVisible="{Binding !IsLocal}" />
        <StackPanel Spacing="2" IsVisible="{Binding IsLocal}">
        <TextBlock Text="Feeder" Classes="section" />
        <ItemsControl ItemsSource="{Binding General}" ItemTemplate="{StaticResource SettingRow}" />

        <TextBlock Text="Controller connection" Classes="section" />
        <ToggleSwitch IsChecked="{Binding IsTcp}" OnContent="TCP (Wi-Fi / Ethernet)" OffContent="USB serial" />
        <StackPanel IsVisible="{Binding IsSerial}" Spacing="2">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
            <TextBlock Text="Serial port" VerticalAlignment="Center" FontSize="16" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding SerialPorts}" SelectedItem="{Binding SerialPort}" MinWidth="200" MinHeight="48" FontSize="17" />
            <Button Grid.Column="2" Content="Rescan" Margin="4,0,0,0" Command="{Binding RefreshPortsCommand}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Serial}" ItemTemplate="{StaticResource SettingRow}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Tcp}" ItemTemplate="{StaticResource SettingRow}" IsVisible="{Binding IsTcp}" />
        <TextBlock Text="{Binding Controller}" Classes="label" TextWrapping="Wrap" />

        <TextBlock Text="Probing and recovery" Classes="section" />
        <ItemsControl ItemsSource="{Binding Machine}" ItemTemplate="{StaticResource SettingRow}" />

        <TextBlock Text="Desktop pairing" Classes="section" />
        <Border Classes="panel" IsVisible="{Binding PairingActive}">
          <StackPanel Spacing="4">
            <TextBlock Text="Enter this code in 3C Tool on the desktop:" />
            <TextBlock Name="PairingCode" Text="{Binding PairingCode}" FontSize="40" FontFamily="monospace" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="Check that the desktop shows this certificate fingerprint:" Classes="label" />
            <TextBlock Text="{Binding PairingFingerprint}" FontFamily="monospace" TextWrapping="Wrap" FontSize="15" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding PairingExpires}" Classes="label" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelPairingCommand}" />
            </Grid>
          </StackPanel>
        </Border>
        <Button Name="StartPairing" Content="Pair a desktop..." Classes="primary" Command="{Binding StartPairingCommand}" IsVisible="{Binding !PairingActive}" />
        <ItemsControl ItemsSource="{Binding Pairings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PairingItemViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="16" />
                  <TextBlock Text="{Binding Details}" Classes="label" />
                </StackPanel>
                <Button Grid.Column="1" Content="Revoke"
                        Command="{Binding $parent[UserControl].((vm:SetupViewModel)DataContext).RevokeCommand}" CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>

        <TextBlock Text="About" Classes="section" />
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Text="Name" Classes="label" Margin="0,0,12,0" />
          <TextBlock Grid.Column="1" Text="{Binding FeederName}" />
          <TextBlock Grid.Row="1" Text="Version" Classes="label" Margin="0,0,12,0" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Version}" />
          <TextBlock Grid.Row="2" Text="Feeder ID" Classes="label" Margin="0,0,12,0" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FeederId}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="3" Text="Certificate" Classes="label" Margin="0,0,12,0" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Fingerprint}" FontFamily="monospace" TextWrapping="Wrap" FontSize="13" />
        </Grid>
        <Button Content="Read controller config" Command="{Binding ReadConfigCommand}" Margin="0,6,0,0" />
        <TextBlock Text="{Binding ConfigText}" TextWrapping="Wrap" FontSize="14" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,4,0,0" IsVisible="{Binding Dirty}">
      <TextBlock Text="Unsaved changes" Classes="label" VerticalAlignment="Center" />
      <Button Content="Revert" Command="{Binding RevertCommand}" />
      <Button Name="SaveButton" Content="Save" Classes="primary" Command="{Binding SaveCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
