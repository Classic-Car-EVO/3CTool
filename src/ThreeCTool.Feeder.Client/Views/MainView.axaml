<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThreeCTool.Feeder.ViewModels"
             xmlns:views="using:ThreeCTool.Feeder.Views"
             x:Class="ThreeCTool.Feeder.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="#121518">
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:KeyboardViewModel"><views:KeyboardView /></DataTemplate>
    <DataTemplate DataType="vm:ConfirmViewModel"><views:ConfirmView /></DataTemplate>
    <DataTemplate DataType="vm:PromptViewModel"><views:PromptView /></DataTemplate>
    <DataTemplate DataType="vm:RecoveryViewModel"><views:RecoveryView /></DataTemplate>
    <DataTemplate DataType="vm:FeedbackViewModel"><views:FeedbackView /></DataTemplate>
  </UserControl.DataTemplates>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- Status bar -->
    <Border Grid.Row="0" Background="#1E2226" Padding="8,4">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Name="StateBadge" CornerRadius="4" Padding="10,2" MinWidth="96" Background="#3A4048"
                Classes.alarm="{Binding HasAlarm}" Classes.running="{Binding IsRunning}">
          <Border.Styles>
            <Style Selector="Border.running"><Setter Property="Background" Value="#2E7D32" /></Style>
            <Style Selector="Border.alarm"><Setter Property="Background" Value="{StaticResource DangerBrush}" /></Style>
          </Border.Styles>
          <TextBlock Text="{Binding MachineState}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" Margin="16,0" VerticalAlignment="Center">
          <TextBlock Classes="value" FontSize="17" Text="{Binding Work.X, StringFormat='X {0}'}" />
          <TextBlock Classes="value" FontSize="17" Text="{Binding Work.Y, StringFormat='Y {0}'}" />
          <TextBlock Classes="value" FontSize="17" Text="{Binding Work.Z, StringFormat='Z {0}'}" />
          <TextBlock Classes="value" FontSize="17" Text="{Binding Work.A, StringFormat='A {0}'}" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding ConnectionText}" Foreground="{StaticResource WarningBrush}"
                   VerticalAlignment="Center" FontSize="14" MaxWidth="260" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <!-- Alarm -->
    <Border Grid.Row="1" Background="{StaticResource DangerBrush}" Padding="8,4" IsVisible="{Binding HasAlarm}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding AlarmText}" Foreground="White" FontSize="17" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Content="Unlock" Margin="4,0" Command="{Binding Jog.UnlockCommand}" />
        <Button Grid.Column="2" Content="Home" Command="{Binding Jog.HomeCommand}" />
      </Grid>
    </Border>

    <TabControl Grid.Row="2" Name="Tabs" SelectedIndex="{Binding SelectedTab}" Padding="6,2,6,6">
      <TabItem Header="Jobs"><views:JobsView DataContext="{Binding Jobs}" /></TabItem>
      <TabItem Header="Run"><views:RunView DataContext="{Binding Run}" /></TabItem>
      <TabItem Header="Jog"><views:JogView DataContext="{Binding Jog}" /></TabItem>
      <TabItem Header="Setup"><views:SetupView DataContext="{Binding Setup}" /></TabItem>
    </TabControl>

    <!-- Messages and errors -->
    <Border Grid.Row="3" Padding="10,4" Background="#2E3A46" IsVisible="{Binding HasMessage}"
            Classes.error="{Binding MessageIsError}">
      <Border.Styles>
        <Style Selector="Border.error"><Setter Property="Background" Value="#7F1D1D" /></Style>
      </Border.Styles>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Message}" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Name="DismissMessage" Content="OK" Command="{Binding DismissMessageCommand}" />
      </Grid>
    </Border>

    <!-- Overlays: keyboard, confirmations, prompts, recovery, feedback -->
    <Border Grid.RowSpan="4" Background="#D0000000" IsVisible="{Binding HasOverlay}">
      <ContentControl Name="OverlayHost" Content="{Binding Overlay}" Margin="12" />
    </Border>
  </Grid>
</UserControl>
