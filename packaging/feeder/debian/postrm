#!/bin/sh
set -e

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

# Purge removes the jobs, run journal, feedback, pairings and the TLS certificate.
if [ "$1" = purge ]; then
    rm -rf /var/lib/3ctool-feeder /etc/3ctool-feeder
    if getent passwd threectool-feeder >/dev/null; then
        deluser --system threectool-feeder >/dev/null 2>&1 || true
    fi
fi

exit 0
